PORT=int,default=8001
HOST=str,default="0.0.0.0"
KAFKA_BOOTSTRAP_SERVERS=str,default="localhost:9099"
KAFKA_CONSUMER_GROUP=str,default="alert-engine-group"
KAFKA_TOPICS=str,default="alerts.budget,alerts.cost.anomaly,llm.toxicity.flagged,alerts.quality.degradation,alerts.latency.slo,alerts.latency.ttft_regression"
REDIS_URL=str,default="redis://localhost:6389/0"
POSTGRES_HOST=str,default="localhost"
POSTGRES_PORT=int,default=5439
POSTGRES_USER=str,default="postgres"
POSTGRES_PASSWORD=str,default="postgres"
POSTGRES_DB=str,default="ewma_db"
POSTGRES_DSN=str,default="postgresql://postgres:postgres@localhost:5439/ewma_db"
SLACK_WEBHOOK_URL=str,default="http://localhost:8080/mock-slack"
PAGERDUTY_ROUTING_KEY=str,default="mock-pagerduty-routing-key"
SERVICE_OWNERS_FILE_PATH=str,default="config/service_owners.yaml"
PROMETHEUS_METRICS_PORT=int,default=9464
HEALTH_CHECK_PORT=int,default=8001
LOG_LEVEL=str,default="INFO"
